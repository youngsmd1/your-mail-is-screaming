    <Item class="ModuleScript" referent="RBX_CourierRecords">
      <Properties>
        <string name="Name">CourierRecords</string>
        <ProtectedString name="Source">-- ServerScriptService &gt; CourierRecords. Each login contributes cumulative deltas.
-- UpdateAsync can replay a write without charging twice, even during a server hop.
local DataStoreService=game:GetService("DataStoreService")
local HttpService=game:GetService("HttpService")
local sandbox=game.PlaceId==0 or game:GetService("RunService"):IsStudio()
local store
if not sandbox then store=DataStoreService:GetDataStore("NightPost_Couriers_v1") end
local records={}
local profiles={}
local punchKeys={"FullBag","ShortcutRun","Express"}
local prices={Firefly=45, Midnight=100}
records.prices=prices
local function cards(data)
	return math.min(data.FullBag,data.ShortcutRun,data.Express)
end
local printNames={"Morrow Moth","Night Window","Water Tower","Last Light"}
local function syncPostmarks(p,r)
	local today=math.floor(os.time()/86400)
	r.syncedDay=today
	local currentWeek=math.floor((today+3)/7)
	local weeks={}
	for date in r.data.stampDays do
		local day=tonumber(date)
		if day then
			local week=math.floor((day+3)/7)
			weeks[week]=(weeks[week] or 0)+1
		end
	end
	local editions={}
	for week,count in weeks do
		if count&gt;=2 then table.insert(editions,week) end
	end
	table.sort(editions,function(a,b) return a&gt;b end)
	local shelf={}
	for i=1,math.min(4,#editions) do
		local week=editions[i]
		local date=os.date("!%d %b %Y",(week*7-3)*86400)
		table.insert(shelf,printNames[week%4+1].."  ·  "..date)
	end
	p:SetAttribute("PrintCount",#editions)
	p:SetAttribute("PrintShelf",table.concat(shelf,"\n"))
	p:SetAttribute("LatestPrint",editions[1] and printNames[editions[1]%4+1] or "")
	p:SetAttribute("WeeklyDesign",printNames[currentWeek%4+1])
	p:SetAttribute("WeeklyDays",math.min(2,weeks[currentWeek] or 0))
end
local function clean(data)
	data=type(data)=="table" and data or {}
	for _,k in {"Coins","Shifts","Stamps","StampDay"} do data[k]=tonumber(data[k]) or 0 end
	for _,key in punchKeys do data[key]=tonumber(data[key]) or 0 end
	data.wraps=type(data.wraps)=="table" and data.wraps or {}
	data.sessions=type(data.sessions)=="table" and data.sessions or {}
	data.stampDays=type(data.stampDays)=="table" and data.stampDays or {}
	if data.StampDay&gt;0 then data.stampDays[tostring(data.StampDay)]=true end
	data.preferences=type(data.preferences)=="table" and data.preferences or {}
	data.terminal=type(data.terminal)=="table" and data.terminal or {}
	data.terminal.receipts=data.terminal.receipts or {}
	return data
end
local function sync(p,r)
	for _,key in {"ClaimDate","ClaimStep","SpinDate","SpinTickets","HornTickets","TourBest"} do
		p:SetAttribute(key,r.data.terminal[key] or 0)
	end
	syncPostmarks(p,r)
	local completed=cards(r.data)
	p:SetAttribute("Cards",completed)
	for _,key in punchKeys do p:SetAttribute(key,r.data[key]-completed) end
	for wrap in prices do p:SetAttribute("Own"..wrap,r.data.wraps[wrap]==true) end
	for _,k in {"Coins","Shifts","Stamps","StampDay"} do p:SetAttribute(k,r.data[k]) end
	for _,k in {"RoofLetter","MallLetter","Ending"} do p:SetAttribute(k,r.data[k]==true) end
	for k,entry in r.data.preferences do
		if k=="Loadout" or k=="Skin" then p:SetAttribute(k,entry.value) end
	end
end
function records.open(p)
	local r={id=HttpService:GenerateGUID(false),data=clean(),coins=0,shifts=0,punches={},days={},revision=0,saved=0}
	for _,key in punchKeys do r.punches[key]=0 end
	profiles[p]=r
	p:SetAttribute("SaveState",sandbox and "Practice session" or "Loading record")
	if store then
		local ok,result=pcall(function() return store:GetAsync(tostring(p.UserId)) end)
		if profiles[p]~=r then return end
		if ok then r.data=clean(result) end
		p:SetAttribute("SaveState",ok and "Record loaded" or "Record pending sync")
		if not ok then r.revision+=1 end
	end
	sync(p,r)
	return r
end
function records.earn(p,coins,success,stampDay,punches,tourLevel)
	local r=profiles[p]
	if tourLevel then
		r.best=math.max(r.best or 0,tourLevel)
		r.data.terminal.TourBest=math.max(r.data.terminal.TourBest or 0,tourLevel)
	end
	local previous=cards(r.data)
	for _,key in punchKeys do
		if punches and punches[key] then
			r.data[key]+=1
			r.punches[key]+=1
		end
	end
	local bonus=15*(cards(r.data)-previous)
	r.coins+=coins
	r.data.Coins+=coins+bonus
	if success then r.shifts+=1; r.data.Shifts+=1 end
	if stampDay and stampDay&gt;r.data.StampDay then
		r.days[tostring(stampDay)]=true
		r.data.stampDays[tostring(stampDay)]=true
		r.data.StampDay=stampDay
		r.data.Stamps+=1
	end
	r.revision+=1
	sync(p,r)
	return bonus
end
function records.equip(p,key,value)
	local r=profiles[p]
	r.data.preferences[key]={value=value,at=workspace:GetServerTimeNow()}
	r.revision+=1
	p:SetAttribute(key,value)
end
function records.mark(p,key)
	local r=profiles[p]
	if r.data[key] then return false end
	r.data[key]=true
	r.revision+=1
	sync(p,r)
	return true
end
local function flush(p,r,purchase,operation)
	if sandbox or r.busy or (r.saved==r.revision and not purchase and not operation) then return false end
	r.busy=true
	local result
	local rev,coins,shifts=r.revision,r.coins,r.shifts
	local days=table.clone(r.days)
	local punches=table.clone(r.punches)
	local best=r.best or 0
	local preferences=table.clone(r.data.preferences)
	local flags={RoofLetter=r.data.RoofLetter,MallLetter=r.data.MallLetter,Ending=r.data.Ending}
	local ok,out=pcall(function()
		return store:UpdateAsync(tostring(p.UserId),function(old)
			local data=clean(old)
			data.terminal.TourBest=math.max(data.terminal.TourBest or 0,best)
			local prior=data.sessions[r.id] or {coins=0,shifts=0}
			local completed=cards(data)
			for _,key in punchKeys do data[key]+=math.max(0,punches[key]-(prior[key] or 0)) end
			data.Coins+=15*(cards(data)-completed)
			data.Coins+=math.max(0,coins-prior.coins)
			if purchase and not data.wraps[purchase] and data.Coins&gt;=prices[purchase] then
				data.Coins-=prices[purchase]
				data.wraps[purchase]=true
			end
			data.Shifts+=math.max(0,shifts-prior.shifts)
			for key in days do
				if not data.stampDays[key] then
					data.stampDays[key]=true
					data.StampDay=math.max(data.StampDay,tonumber(key))
					data.Stamps+=1
				end
			end
			for key,entry in preferences do
				local priorPref=data.preferences[key]
				if not priorPref or entry.at&gt;priorPref.at then data.preferences[key]=entry end
			end
			for k,v in flags do if v then data[k]=true end end
			for id,receipt in data.sessions do
				if receipt.time and os.time()-receipt.time&gt;7*86400 then data.sessions[id]=nil end
			end
			data.sessions[r.id]={coins=coins,shifts=shifts,time=os.time()}
			for _,key in punchKeys do data.sessions[r.id][key]=punches[key] end
			if operation then result=operation(data.terminal,data) end
			return data
		end)
	end)
	r.busy=false
	if ok and out then
		r.saved=rev
		r.data.terminal=out.terminal
		r.data.terminal.TourBest=math.max(r.data.terminal.TourBest or 0,r.best or 0)
		for _,key in punchKeys do r.data[key]=out[key]+r.punches[key]-punches[key] end
		r.data.wraps=out.wraps
		r.data.Coins=out.Coins+r.coins-coins+15*(cards(r.data)-cards(out))
		r.data.Shifts=out.Shifts+r.shifts-shifts
		r.data.Stamps=out.Stamps
		for key in r.days do
			if out.stampDays[key] then r.days[key]=nil else r.data.Stamps+=1 end
		end
		r.data.StampDay=math.max(out.StampDay,r.data.StampDay)
		for key in out.stampDays do r.data.stampDays[key]=true end
		for key,entry in out.preferences do
			local localPref=r.data.preferences[key]
			if not localPref or entry.at&gt;localPref.at then r.data.preferences[key]=entry end
		end
		for _,k in {"RoofLetter","MallLetter","Ending"} do r.data[k]=r.data[k] or out[k] end
		if p.Parent then sync(p,r); p:SetAttribute("SaveState","Record saved") end
		return true,result
	elseif p.Parent then p:SetAttribute("SaveState","Save pending") end
	return false
end
function records.terminal(p,operation)
	local r=profiles[p]
	if not r or r.leaving or r.busy then return false end
	if sandbox then
		local result=operation(r.data.terminal,r.data)
		sync(p,r)
		return true,result
	end
	return flush(p,r,nil,operation)
end
function records.buy(p,wrap)
	local r=profiles[p]
	local cost=prices[wrap]
	if not r or not cost then return end
	if not r.data.wraps[wrap] then
		if r.data.Coins&lt;cost then return "Need "..cost.." coins for this wrap." end
		if sandbox then
			r.data.Coins-=cost
			r.data.wraps[wrap]=true
			sync(p,r)
		elseif not flush(p,r,wrap) then
			return "Purchase pending verification. Try again in a moment."
		end
	end
	if r.data.wraps[wrap] and profiles[p]==r and not r.leaving then
		records.equip(p,"Skin",wrap)
		return wrap.." wrapping equipped."
	end
	return "Check your balance and try again."
end
function records.close(p)
	local r=profiles[p]
	if not r then return end
	r.leaving=true
	for _=1,6 do
		while r.busy do task.wait(.1) end
		flush(p,r)
		if sandbox or r.saved==r.revision then profiles[p]=nil; return end
		task.wait(1)
	end
end
task.spawn(function()
	while task.wait(10) do
		for p,r in profiles do
			if p.Parent and r.syncedDay and r.syncedDay~=math.floor(os.time()/86400) then syncPostmarks(p,r) end
			if r.leaving and not r.busy and r.saved==r.revision then profiles[p]=nil
			else task.spawn(flush,p,r) end
		end
	end
end)
game:BindToClose(function()
	if sandbox then return end
	local count=0
	for p in profiles do
		count+=1
		task.spawn(function() records.close(p); count-=1 end)
	end
	local limit=time()+26
	while count&gt;0 and time()&lt;limit do task.wait(.1) end
end)
return records
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_Depot">
      <Properties>
        <string name="Name">Depot</string>
        <ProtectedString name="Source">-- ServerScriptService &gt; Depot. Builds the working props against the original rooftop blockout.
local d = workspace.NightPost
local V, rgb = Vector3.new, Color3.fromRGB
local steel, yellow, red = rgb(51,67,75), rgb(250,185,55), rgb(197,58,62)
local function model(name,parent)
	local m = Instance.new("Model")
	m.Name, m.Parent = name,parent
	return m
end
local function part(parent,name,size,pos,color,collide,material)
	local p = Instance.new("Part")
	p.Name,p.Size,p.Position,p.Color = name,size,pos,color
	p.Anchored,p.CanCollide = true,collide == true
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface,p.BottomSurface = Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local function sign(p,words,face)
	local s = Instance.new("SurfaceGui")
	s.Face,s.LightInfluence,s.PixelsPerStud = face or Enum.NormalId.Back,0,40
	s.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	s.Parent = p
	local t = Instance.new("TextLabel")
	t.Size,t.BackgroundTransparency = UDim2.fromScale(1,1),1
	t.TextColor3,t.TextScaled,t.Font = rgb(254,237,192),true,Enum.Font.GothamBold
	t.Text,t.Parent = words,s
	return t
end
local function prompt(p,name,action,object,range)
	local q=Instance.new("ProximityPrompt")
	q.Name,q.ActionText,q.ObjectText = name,action,object
	q.MaxActivationDistance,q.HoldDuration,q.RequiresLineOfSight = range or 8,0.18,false
	q.Parent=p
	return q
end
local function sound(p,name,file,volume,speed)
	local s=Instance.new("Sound")
	s.Name,s.SoundId,s.Volume,s.PlaybackSpeed=name,"rbxasset://sounds/"..file,volume,speed
	s.RollOffMaxDistance,s.RollOffMinDistance=85,8
	s.Parent=p
	return s
end
local function rod(parent,name,a,b,width,color)
	local p=part(parent,name,V(width,width,(b-a).Magnitude),(a+b)/2,color,false,Enum.Material.Metal)
	p.CFrame=CFrame.lookAt((a+b)/2,b)
	return p
end
local depot={part=part,model=model,sign=sign,rod=rod,sound=sound}
local works=model("NightShift",d)
-- The service walk follows the outside wall. Its two landings connect to the roof edges.
local exteriorOffset=V(-32,0,0)
d.MaintenanceBridge.Position+=exteriorOffset
for _,piece in d.BridgeHardware:GetChildren() do
	if piece:IsA("BasePart") then piece.Position+=exteriorOffset end
end
for _,z in {15,-15} do
	part(works,"ServiceLanding",V(33,1,7),V(-42,23.7,z),steel,true,Enum.Material.DiamondPlate)
	local outside=z+(z&gt;0 and 3.4 or -3.4)
	part(works,"LandingRail",V(31,.26,.26),V(-43,27,outside),yellow,true)
	for x=-57,-29,7 do part(works,"LandingPost",V(.24,2.8,.24),V(x,25.6,outside),yellow,true) end
end
local board=part(works,"JobBoard",V(7,4,0.7),V(14,27,36),steel,true)
sign(board,"DISPATCH\nJOBS &amp; LOCKERS")
depot.board=prompt(board,"Browse","Read job board","Dispatch",9)
depot.pad=prompt(d.OpenHere,"Unpack","Open 1 parcel","OPEN HERE",7)
depot.squeal=sound(d.OpenHere,"BoxSqueal","ouch.ogg",1.15,2.15)
depot.chirp=sound(d.OpenHere,"SpringChirp","action_get_up.mp3",0.8,2.6)
local tower=model("MorrowWater",works)
for _,x in {-2,2} do
	for _,z in {-2,2} do part(tower,"Leg",V(.45,7,.45),V(16+x,27.5,-38+z),steel,true) end
end
local tank=part(tower,"Tank",V(7.5,8,8),V(16,34,-38),rgb(104,127,124),true,Enum.Material.Metal)
tank.Shape=Enum.PartType.Cylinder
tank.Orientation=V(0,0,90)
sign(part(tower,"Plate",V(6,1.4,.25),V(16,34,-33.9),steel,false),"MORROW WATER")
local fire=model("FireEscape",works)
for _,x in {2,6} do part(fire,"Stringer",V(.28,24,.28),V(x,12,11.5),steel,false) end
for i=1,14 do part(fire,"Rung",V(4,.16,.3),V(4,i*1.65,11.5),steel,false) end
part(fire,"Landing",V(6,.3,3),V(4,23.9,10.7),steel,true,Enum.Material.DiamondPlate)
local letter=part(works,"DeadLetter",V(1.7,.22,1.15),V(16,24.5,-43),rgb(247,220,157),false)
sign(letter,"RETURN",Enum.NormalId.Top)
depot.letter=prompt(letter,"Read","Read undeliverable letter","Dead letters",5)
-- The warning beacon sits on the escape that the Unclaimed actually climbs.
depot.lamp=part(fire,"EscapeBeacon",V(.85,.75,.85),V(7,26.8,11.8),yellow,false,Enum.Material.Neon)
local beacon=Instance.new("PointLight")
beacon.Range,beacon.Brightness,beacon.Color,beacon.Parent=16,2,yellow,depot.lamp
local base=d.RedMailbox.Position
local fittings={}
for _,name in {"Slot","PostalBadge","DropSign","DropSignMount"} do
	local p=d.StreetScenery[name]
	fittings[p]=p.Position-base
end
local mall=model("BellwetherArcade",works)
local awning=rgb(76,114,108)
for i,name in {"RECORDS","MOTH ARCADE","ALTERATIONS"} do
	local x=(i-2)*16
	part(mall,"Storefront",V(14,7,1.5),V(x,27.7,-48),steel,true)
	for row=1,7 do part(mall,"Slat",V(12,.65,.4),V(x,24.4+row*.84,-47.1),rgb(106,119,122),false,Enum.Material.Metal) end
	sign(part(mall,"ShopName",V(14,1.8,.8),V(x,32,-47),awning,false),name)
	part(mall,"Canopy",V(15,.4,4),V(x,30.9,-46),awning,true)
end
local marquee=part(mall,"Marquee",V(22,3,.5),V(-9,37,-49),rgb(124,47,62),false)
sign(marquee,"BELLWETHER MALL")
local shutter=part(mall,"MailShutter",V(4.5,3,.4),base+V(0,.6,1.85),steel,false,Enum.Material.Metal)
local shutterText=sign(shutter,"CLOSED")
local indicator=part(mall,"ShutterLamp",V(4.5,.3,.4),base+V(0,2.3,1.85),red,false,Enum.Material.Neon)
local mallParts={}
for _,p in mall:GetDescendants() do
	if p:IsA("BasePart") then mallParts[p]={p.CFrame,p.CanCollide} end
end
local specialPlate=part(works,"ReturnedMail",V(5,3,.6),V(19,26,-29),steel,true)
sign(specialPlate,"DEAD LETTER\nOFFICE")
depot.final=prompt(specialPlate,"HandOver","Hand over the last letter","The Unclaimed",8)
local locations={V(16,26.8,-46),V(-16,26.8,-39),V(20,26.8,-27)}
local dailyNames={"behind the water tower","at the west roof rail","by the east loading bay"}

-- Three physical sorting windows. Couriers receive individual destination labels.
local hall=model("SortingHall",works)
local hallFixtures={}
local function fixture(name,size,pos,color,solid,material)
	local p=part(hall,name,size,pos,color,solid,material)
	hallFixtures[p]={home=p.CFrame,solid=solid==true}
	return p
end
local header=fixture("OfficeSign",V(28,3,1),V(-5,33.8,-38),steel,true)
sign(header,"MISPRINT OFFICE")
fixture("OfficeAwning",V(29,.38,5.5),V(-5,31.7,-37.2),rgb(146,83,70),true,Enum.Material.Metal)
fixture("Gutter",V(29,.35,.3),V(-5,31.55,-34.45),yellow,false)
local stations={{"Moon",rgb(84,109,183)},{"Moth",rgb(42,134,113)},{"Match",rgb(183,77,56)}}
depot.bins={}
for i,station in stations do
	local x=-15+(i-1)*10
	local name,color=station[1],station[2]
	fixture("Pillar",V(.6,8,.6),V(x,28,-38),steel,true)
	local bin=fixture(name,V(6.8,3.7,2.8),V(x,26.1,-36.3),color,true)
	sign(bin,string.upper(name))
	fixture("Intake",V(4.7,.45,.22),V(x,27.35,-34.81),steel,false)
	fixture("FeedTray",V(5.1,.16,1.25),V(x,27.07,-34.35),rgb(142,151,149),false,Enum.Material.Metal)
	for side=-1,1,2 do
		fixture("TrayEdge",V(.12,.33,1.25),V(x+side*2.5,27.16,-34.35),steel,false)
	end
	fixture("WorkLight",V(5,.25,.6),V(x,30,-36),color,false,Enum.Material.Neon)
	depot.bins[name]=prompt(bin,"Sort","Stamp manifest",name.." window",5.5)
end
local function selectJob(job,day)
	local isMall=job=="Mall"
	d:SetAttribute("Job",job)
	d:SetAttribute("Day",day)
	d:SetAttribute("DailyTarget",dailyNames[day%3+1])
	for p,data in hallFixtures do
		p.CFrame=data.home+(job=="Misprint" and Vector3.zero or V(0,-120,0))
		p.CanCollide=job=="Misprint" and data.solid
	end
	local pos=job=="Daily" and locations[day%3+1] or base
	d.RedMailbox.Position=pos
	for p,delta in fittings do p.Position=pos+delta end
	for p,data in mallParts do
		p.CFrame=data[1]+(isMall and Vector3.zero or V(0,-120,0))
		p.CanCollide=isMall and data[2]
	end
	letter.Position=isMall and V(-2,24.6,-45.4) or V(16,24.6,-43)
	specialPlate.Position=job=="LastLetter" and V(19,26,-29) or V(19,-100,-29)
end
depot.selectJob=selectJob
function depot.shutter(open)
	d:SetAttribute("ShutterOpen",open)
	if d:GetAttribute("Job")=="Mall" then
		shutter.Position=base+V(0,open and 3.6 or .6,1.85)
		shutterText.Text=open and "OPEN" or "CLOSED"
		indicator.Color=open and rgb(95,255,164) or red
	end
end
local shortcut=model("Shortcut",works)
function depot.clearShortcut() shortcut:ClearAllChildren() end
function depot.spring()
	local c=V(4,24.55,15)
	part(shortcut,"Crate",V(4,.6,4),c,rgb(164,100,62),false)
	local last=c+V(1.5,.3,0)
	for i=1,36 do
		local angle=i*math.pi/6
		local point=c+V(math.cos(angle)*1.5,.3+i*.052,math.sin(angle)*1.5)
		rod(shortcut,"Coil",last,point,.28,yellow)
		last=point
	end
	part(shortcut,"Cap",V(4.4,.32,4.4),c+V(0,2.4,0),yellow,false)
end
function depot.bridge(progress)
	local length=math.max(.3,28*progress)
	local deck=shortcut:FindFirstChild("FoldingDeck")
	if not deck then deck=part(shortcut,"FoldingDeck",V(6,.35,length),V(4,24.05,14-length/2),rgb(197,157,102),false,Enum.Material.WoodPlanks) end
	deck.Size=V(6,.35,length)
	deck.Position=V(4,24.05,14-length/2)
	deck.CanCollide=progress&gt;=1
	if progress&gt;=1 then
		for i=1,6 do part(shortcut,"Hinge",V(5.9,.07,.18),V(4,24.26,13-i*4),steel,false) end
	end
	return deck
end
return depot
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_Unclaimed">
      <Properties>
        <string name="Name">Unclaimed</string>
        <ProtectedString name="Source">-- ServerScriptService &gt; Unclaimed
local depot=require(script.Parent.Depot)
local d=workspace.NightPost
local V,rgb=Vector3.new,Color3.fromRGB
local actor=depot.model("The Unclaimed",d)
local origin=V(0,0,0)
local function limb(name,size,offset,color)
	return depot.part(actor,name,size,origin+offset,color,false,Enum.Material.Fabric)
end
local navy,leather,gray=rgb(42,58,83),rgb(104,68,46),rgb(154,143,116)
local torso=limb("Old uniform",V(2.25,2.2,1.1),V(0,0,0),navy)
actor.PrimaryPart=torso
limb("Face in shadow",V(1.25,1.25,1.1),V(0,1.73,0),gray)
limb("Postal cap",V(1.57,.6,1.4),V(0,2.45,0),navy)
limb("Visor",V(1.5,.15,.7),V(0,2.16,-.53),rgb(32,36,44))
limb("Cap badge",V(.35,.29,.1),V(0,2.45,-.73),rgb(216,179,96))
for _,x in {-1.38,1.38} do limb("Sleeve",V(.55,2,.8),V(x,-.07,0),navy) end
for _,x in {-.58,.58} do limb("Boot",V(.8,1.8,1),V(x,-1.93,0),rgb(38,39,44)) end
limb("Satchel",V(1.5,1.15,.65),V(.55,-.7,-.7),leather)
depot.sign(limb("Nameplate",V(.8,.35,.09),V(-.5,.6,-.6),leather),"POST",Enum.NormalId.Front)
local steps=depot.sound(torso,"FireEscapeSteps","action_footsteps_plastic.mp3",.85,.67)
steps.Looped=true
local light=depot.lamp and depot.lamp:FindFirstChildOfClass("PointLight")
local normalColor=depot.lamp and depot.lamp.Color
local patrol={V(-22,3.1,2),V(25,3.1,2)}
local points={V(4,3.1,10),V(4,15,10),V(4,27.2,11),V(4,27.2,17),V(9,27.2,17),V(4,27.2,14)}
local mode,index,pos,facing,waitUntil="Patrol",1,patrol[2],V(-1,0,0),0
local start=0
local function setMode(m)
	mode=m
	d:SetAttribute("Creature",m)
	if m=="Investigate" then steps:Play() elseif m=="Patrol" or m=="Waiting" then steps:Stop() end
end
local function pose(t)
	local bob=mode=="Waiting" and 0 or math.sin(t*8)*.09
	local here=pos+V(0,bob,0)
	actor:PivotTo(CFrame.lookAt(here,here+facing))
end
local function walk(target,speed,dt)
	local delta=target-pos
	if delta.Magnitude&lt;=speed*dt then pos=target; return true end
	local horizontal=V(delta.X,0,delta.Z)
	if horizontal.Magnitude&gt;.2 then facing=horizontal.Unit end
	pos+=delta.Unit*speed*dt
	return false
end
local module={}
function module.reset(final)
	if light then light.Enabled=true; depot.lamp.Color=normalColor end
	pos=final and V(19,27.2,-32) or patrol[2]
	facing=final and V(0,0,1) or V(-1,0,0)
	index=1
	setMode(final and "Waiting" or "Patrol")
	pose(0)
end
function module.lure(now)
	start,index,waitUntil=now,1,now+3.8
	setMode("Investigate")
end
function module.step(now,dt)
	local danger=false
	if mode=="Patrol" then
		if walk(patrol[index],6,dt) then index=3-index end
	elseif mode=="Investigate" then
		if light then
			local on=now-start&gt;2.4 or math.floor((now-start)*6)%2==0
			light.Enabled=on
			depot.lamp.Color=on and normalColor or rgb(59,57,59)
		end
		if index&lt;=#points then
			if index~=3 or now&gt;=waitUntil then
				danger=index&gt;=4
				if walk(points[index],index&gt;=4 and 4 or 15,dt) then index+=1 end
			end
		else
			index=3
			setMode("Return")
		end
	elseif mode=="Return" then
		if walk(points[index],9,dt) then
			index-=1
			if index==0 then index=1; setMode("Patrol") end
		end
	end
	pose(now)
	return danger and pos or nil
end
module.reset(false)
return module
</ProtectedString>
      </Properties>
    </Item>
  <Item class="ModuleScript" referent="RBXnewParcelTour"><Properties><string name="Name">ParcelTour</string><ProtectedString name="Source">local W=require(script.Parent.PostalScenery)
local records=require(script.Parent.CourierRecords)
local V=Vector3.new
local jobs={}
local Tour={}
local rooms={
 {"Receiving Hall",{"Anchor","Bell","Lantern"},{"I hold a vessel still.","I speak when struck.","My flame travels with you."}},
 {"Family Archive",{"Key","Quill","Seal"},{"My teeth turn a lock.","My nib leaves a trail.","I leave an impression in warm wax."}},
 {"Last Post Office",{"Moon","Tide","Clock"},{"I vanish and return above the roof.","I climb the harbor wall without feet.","I have hands but cannot hold a letter."}},
}
local function tell(p,line) p:SetAttribute("TourHint",line) end
local function finish(j,msg)
 if jobs[j.slot]~=j then return end
 jobs[j.slot]=nil
 if j.map then j.map:Destroy() end
 for _,p in j.crew do if p.Parent then j.home(p,msg) end end
 j.done()
end
local function place(p,pos)
 local c=p.Character
 if c and c:FindFirstChild("HumanoidRootPart") then
  c:PivotTo(CFrame.new(pos));c.HumanoidRootPart.AssemblyLinearVelocity=Vector3.zero
 end
end
local function openRoom(j)
 if j.map then j.map:Destroy() end
 local index=j.level
 local data=rooms[index]
 local reader=j.crew[(index-1)%2+1]
 local sorter=j.crew[index%2+1]
 local o=V(700+j.slot*220,52,-400)
 local map=W.model(workspace,"DeadLetterHouse_"..j.slot);j.map=map
 local wood=Color3.fromRGB(90,63,48)
 local plaster=({Color3.fromRGB(117,111,94),Color3.fromRGB(82,101,98),Color3.fromRGB(109,87,83)})[index]
 local function part(n,size,x,y,z,col,solid,mat)
  return W.part(map,n,size,o+V(x,y,z),col,solid,mat or Enum.Material.WoodPlanks)
 end
 part("Parquet",V(50,1,42),0,-.5,0,wood,true)
 part("Ceiling",V(50,1,42),0,15,0,plaster,true,Enum.Material.Plaster)
 for _,side in {-1,1} do
  part("Paneled wall",V(1,15,42),side*25,7.5,0,plaster,true)
  part("Gallery wall",V(50,15,1),0,7.5,side*21,plaster,true)
  part("Wainscot",V(.5,4,42),side*24.35,2,0,wood,true)
  part("Dado rail",V(49,.35,1),0,4,side*20.35,wood,false)
  part("Transom",V(6,10,1),side*11,5,2,wood,true)
  for x=-16,16,8 do part("Ceiling joist",V(.48,.7,20),x,14.2,side*10,wood,false) end
  local lamp=part("Milk glass sconce",V(1.1,1.8,1),side*17,6,-19.8,W.cream,false,Enum.Material.Neon)
  W.light(lamp,W.brass,32)
 end
 part("Runner",V(9,.09,36),0,.07,0,Color3.fromRGB(111,51,49),false,Enum.Material.Fabric)
 for i=1,3 do
  local x=-17+(i-1)*17
  if index==1 then
   part("Luggage trunk",V(5,3,3),x,1.5,17,wood,true)
   part("Leather strap",V(.45,3.1,3.1),x+1,1.5,17,W.brass,false)
  elseif index==2 then
   part("Bookcase",V(8,9,2),x,4.5,19,wood,true)
   for k=1,12 do part("Cloth spine",V(.78,2,.7),x-2.8+k%6,2+math.floor((k-1)/6)*3,17.85,k%2==0 and W.teal or W.red,false) end
  else
   for k=1,4 do part("Letter drawer",V(6,1.4,3),x,k*1.5-.75,18,wood,true);part("Brass pull",V(1,.25,.25),x,k*1.5-.65,16.4,W.brass,false) end
  end
 end
 local desk=part("Evidence desk",V(6,3,3),-16,1.5,-12,wood,true)
 local ledger=part("Witness statement",V(3,.35,2),-16,3.2,-12,W.cream,false)
 W.label(part("Door plate",V(13,2,.3),0,8,-20,wood,false),string.upper(data[1]))
 -- The rooms share a footprint but have distinct light sources and furnishings.
 for _,side in {-1,1} do
  local wx=side*24.2
  part("Rain glass",V(.18,7,7),wx,8,9,Color3.fromRGB(95,119,132),false,Enum.Material.Glass)
  part("Window crossbar",V(.45,.3,7.5),wx-side*.12,8,9,wood,false)
  part("Window mullion",V(.45,7.5,.3),wx-side*.12,8,9,wood,false)
 end
 if index==1 then
  part("Hearth stone",V(10,.4,5),0,.25,17,plaster,true)
  part("Chimney breast",V(9,14,2),0,7,19,plaster,true,Enum.Material.Brick)
  part("Firebox",V(5,4,.4),0,2,17.8,W.ink,false)
  part("Oak mantel",V(11,.65,3),0,5,18,wood,true)
  local ember=part("Banked coals",V(3,.32,.8),0,.6,17.2,Color3.fromRGB(204,108,65),false,Enum.Material.Neon);W.light(ember,ember.Color,12)
 elseif index==2 then
  for i=1,4 do
   part("Picture frame",V(4.5,5,.5),-18+i*7,9,-20,W.brass,false)
   part("Family silhouette",V(3.8,4.2,.6),-18+i*7,9,-19.9,wood,false)
   W.orb(map,"Portrait bust",V(1.6,2.6,.22),o+V(-18+i*7,9,-19.48),W.ink)
  end
 else
  for i=1,7 do part("Service grille",V(.18,4,.2),-4+i,8,-18,W.brass,false) end
  W.label(part("Counter plate",V(8,1.2,.3),0,5.3,-18,wood,false),"RETURN TO SENDER")
 end
 local correct=math.random(3)
 local revealed,solved=false,false
 local shade=W.figure(map,"Resident postmaster",o+V(0,0,-8),true)
 local deadline=workspace:GetServerTimeNow()+105
 local alarmUntil=0
 local function allowed(p,obj)
  local r=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
  return jobs[j.slot]==j and j.map==map and not solved and r and (r.Position-obj.Position).Magnitude&lt;10
 end
 local function scan(p)
  if not allowed(p,ledger) then return end
  if p~=reader then tell(p,"Your partner reads the statement. You operate the lock.");return end
  revealed=true
  for _,member in j.crew do tell(member,"Witness statement: “"..data[3][correct].."”  Choose the matching brass plate.") end
 end
 W.prompt(ledger,"Read","Relay statement",8).Triggered:Connect(scan)
 for i,label in data[2] do
  local panel=part(label,V(4,4,2),12+(i-2)*5,2,-12,W.teal,true)
  W.label(panel,label)
  W.prompt(panel,"Select","Turn seal",7).Triggered:Connect(function(p)
   if not allowed(p,panel) then return end
   if p~=sorter then tell(p,"Only your partner has the winding key.");return end
   if not revealed then tell(p,"Wait for your partner to relay the statement.");return end
   if time()&lt;alarmUntil then return end
   if i~=correct then
    revealed=false;alarmUntil=time()+4;deadline-=5
    for _,member in j.crew do member:SetAttribute("TourEnds",deadline);tell(member,"Wrong seal. The keeper is coming. Reader, relay the statement again.") end
    place(p,o+V(6,3,12));return
   end
   solved=true
   for _,member in j.crew do records.earn(member,10+5*index,true,index==3 and math.floor(workspace:GetServerTimeNow()/86400) or nil,nil,index) end
   if jobs[j.slot]~=j then return end
   if index==3 then finish(j,"Case closed. The postmaster finally received his letter.")
   else j.level+=1;openRoom(j) end
  end)
 end
 for i,p in j.crew do
  p:SetAttribute("Area","Tour");p:SetAttribute("TourTitle",data[1]);p:SetAttribute("TourEnds",deadline);p:SetAttribute("LegDuration",105)
  tell(p,p==reader and "Reader: find the ivory statement on the west desk and relay it." or "Keyholder: wait for the statement, then choose one of the three brass seals.")
  place(p,o+V(i*5-8,3,12))
 end
 local ghostPos=Vector3.new(0,3.3,-5)
 j.tick=function()
  local t=time()
  local x=time()&lt;alarmUntil and 9 or 7*math.sin(t*.55)
  local walking=time()&lt;alarmUntil
  local goal=V(x,3.3,walking and 6 or -4+math.cos(t*.55)*2)
  ghostPos=ghostPos:Lerp(goal,walking and .16 or .09)
  local pos=o+ghostPos+V(0,.055*math.sin(t*6),0)
  local target=sorter.Character and sorter.Character:FindFirstChild("HumanoidRootPart")
  local facing=walking and target and V(pos.X-target.Position.X,0,pos.Z-target.Position.Z)
  local pose=if facing and facing.Magnitude&gt;.1 then CFrame.lookAt(pos,pos+facing) else CFrame.new(pos)*CFrame.Angles(0,math.sin(t*.55)*1.3,0)
  shade:PivotTo(pose)
  if workspace:GetServerTimeNow()&gt;deadline and not solved then finish(j,"The house closed at dawn. Board together to reopen the case.") end
 end
end
function Tour.start(slot,crew,home,done)
 if #crew~=2 then return end
 jobs[slot]={slot=slot,crew=crew,home=home,done=done,ready={},level=1,untilTime=time()+90}
 for _,p in crew do p:SetAttribute("Area","Tutorial") end
end
function Tour.ready(p)
 for _,j in jobs do if table.find(j.crew,p) and not j.map then
  j.ready[p]=true;p:SetAttribute("TutorialReady",true)
  if j.ready[j.crew[1]] and j.ready[j.crew[2]] then openRoom(j) end
  return
 end end
end
function Tour.leave(p)
 for _,j in jobs do if table.find(j.crew,p) then finish(j,"Your partner left. Board again with another courier.");return end end
end
function Tour.respawn(p)
 for _,j in jobs do if j.map and table.find(j.crew,p) then place(p,V(700+j.slot*220,55,-388)) end end
end
task.spawn(function()
 while task.wait(.12) do for _,j in jobs do if j.tick then j.tick() elseif time()&gt;j.untilTime then finish(j,"Boarding expired.") end end end
end)
return Tour</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXnewPostalScenery"><Properties><string name="Name">PostalScenery</string><ProtectedString name="Source">local W={}
local V,rgb=Vector3.new,Color3.fromRGB
W.ink=rgb(28,46,62)
W.brass=rgb(229,173,79)
W.teal=rgb(41,118,112)
W.cream=rgb(253,229,180)
W.red=rgb(180,57,63)
function W.model(parent,name)
	local m=Instance.new("Model");m.Name=name;m.Parent=parent;return m
end
function W.part(parent,name,size,pos,color,solid,material)
	local p=Instance.new("Part")
	p.Name,p.Size,p.Position,p.Color=name,size,pos,color
	p.Anchored,p.CanCollide=true,solid==true
	p.Material=material or Enum.Material.SmoothPlastic
	p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
	p.Parent=parent
	return p
end
function W.orb(parent,name,size,pos,color,mat)
	local p=W.part(parent,name,size,pos,color,false,mat);p.Shape=Enum.PartType.Ball;return p
end
function W.beam(parent,a,b,width,color)
	local p=W.part(parent,"Frame",V(width,width,(b-a).Magnitude),(a+b)/2,color,false,Enum.Material.Metal)
	p.CFrame=CFrame.lookAt((a+b)/2,b);return p
end
function W.label(p,words,color)
	local g=Instance.new("SurfaceGui");g.Face=Enum.NormalId.Back;g.LightInfluence=0
	g.CanvasSize=Vector2.new(math.ceil(p.Size.X*54),math.ceil(p.Size.Y*54));g.Parent=p
	local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(.94,.9);t.Position=UDim2.fromScale(.03,.05)
	t.TextScaled,t.TextWrapped,t.BackgroundTransparency=true,true,1
	t.Font,t.TextColor3,t.Text=Enum.Font.GothamBold,color or W.cream,words;t.Parent=g;return t
end
function W.prompt(p,name,action,dist)
	local q=Instance.new("ProximityPrompt");q.Name=name;q.ActionText=action;q.ObjectText=p.Name
	q.HoldDuration=.22;q.MaxActivationDistance=dist or 9;q.RequiresLineOfSight=false;q.Parent=p;return q
end
function W.light(p,color,range)
	local l=Instance.new("PointLight");l.Color,l.Range,l.Brightness,l.Parent=color,range,1.6,p
end
function W.person(parent,name,pos,coat,face,kind)
	local m=W.model(parent,name)
	local function body(n,size,offset,c) return W.part(m,n,size,pos+offset,c,false) end
	local torso=body("Coat",V(2.4,2.3,1.3),V(0,3.3,0),coat);m.PrimaryPart=torso
	body("Face",V(1.5,1.45,1.3),V(0,5.2,0),face)
	body("Visor",V(2,.23,1.9),V(0,5.85,.13),W.ink)
	body("Crown",V(1.7,.62,1.5),V(0,6.13,0),coat)
	body("Badge",V(.48,.48,.12),V(-.56,3.7,.7),W.brass).Rotation=V(0,0,45)
	body("Satchel",V(1.1,1.2,.7),V(.92,2.55,.65),rgb(126,77,49))
	for _,s in {-1,1} do
		body("Boot",V(.95,2,1.05),V(.62*s,1,0),W.ink)
		body("Sleeve",V(.65,1.9,.9),V(1.48*s,3.23,0),coat)
		body("Eye",V(.23,.19,.1),V(s*.36,5.28,.68),kind and W.brass or W.ink)
	end
	if kind=="Moth" then
		for _,s in {-1,1} do
			local wing=W.orb(m,"Velvet wing",V(2.5,4,.4),pos+V(1.8*s,3.8,-.62),rgb(149,112,184));wing.Rotation=V(0,0,s*-28)
		end
	elseif kind=="Hound" then
		for _,s in {-1,1} do body("Receiver ear",V(.48,1.7,.6),V(s*.67,6.42,0),coat).Rotation=V(0,0,-s*13) end
		body("Snout",V(1.23,.7,1),V(0,4.95,.87),W.ink)
	elseif kind=="Clock" then
		W.label(body("Dial",V(1.55,1.5,.16),V(0,5.25,.75),W.cream),"XII\n◷",W.ink)
		W.beam(m,pos+V(-1.4,6.7,0),pos+V(1.4,6.7,0),.3,W.brass)
	end
	return m
end
function W.box(parent,pos,size,color)
	local box=W.part(parent,"Freight",size,pos,color,true,Enum.Material.Wood)
	W.part(parent,"Paper tape",V(size.X*.16,size.Y+.04,size.Z+.04),pos,W.cream,false)
	W.label(W.part(parent,"Waybill",V(size.X*.48,size.Y*.38,.05),pos+V(-size.X*.16,0,size.Z*.5),W.cream,false),"AIR  ▥",W.ink)
	return box
end
function W.figure(parent,name,feet,ghost)
	local m=W.model(parent,name)
	local cloth=ghost and rgb(54,62,60) or rgb(49,69,79)
	local skin=ghost and rgb(165,162,147) or rgb(179,130,102)
	local function oval(n,size,x,y,z,c)
		return W.orb(m,n,size,feet+V(x,y,z),c,Enum.Material.SmoothPlastic)
	end
	m.PrimaryPart=oval("Wool jacket",V(1.98,2.18,1.04),0,3.3,0,cloth)
	oval("Coat skirt",V(2,1.52,1.1),0,2.55,-.04,cloth)
	oval("Collar",V(.84,.46,.8),0,4.33,0,W.cream)
	oval("Face",V(1.19,1.46,1.04),0,4.97,.02,skin)
	oval("Nose",V(.23,.38,.28),0,4.96,.51,skin)
	oval("Cap crown",V(1.48,.54,1.27),0,5.68,0,cloth)
	oval("Leather peak",V(1.46,.15,1.1),0,5.48,.37,W.ink)
	for _,side in {-1,1} do
		oval("Trouser",V(.71,2.1,.77),side*.44,1.29,0,cloth)
		oval("Boot",V(.74,.62,1.2),side*.44,.34,.17,W.ink)
		oval("Sleeve",V(.65,1.69,.73),side*.99,3.29,0,cloth).Rotation=V(-8,0,side*9)
		oval("Hand",V(.4,.52,.45),side*1.09,2.42,.13,skin)
		oval("Eye",V(.17,.09,.11),side*.26,5.13,.48,W.ink)
		oval("Brow",V(.34,.08,.13),side*.27,5.23,.45,cloth)
		oval("Ear",V(.19,.37,.28),side*.59,5,0,skin)
	end
	for i=1,4 do oval("Brass button",V(.12,.12,.12),0,2.75+i*.32,.49,W.brass) end
	for _,side in {-1,1} do
		local lapel=W.part(m,"Folded lapel",V(.29,.9,.09),feet+V(side*.29,3.93,.47),cloth:Lerp(W.ink,.42),false,Enum.Material.Fabric)
		lapel.Rotation=V(0,0,side*-23)
		oval("Temple",V(.24,.68,.52),side*.51,5.22,-.12,W.ink)
	end
	oval("Philtrum",V(.33,.045,.07),0,4.7,.48,skin:Lerp(W.ink,.42))
	oval("Cap badge",V(.27,.29,.11),0,5.69,.62,W.brass)
	for _,piece in m:GetChildren() do
		if piece.Name=="Wool jacket" or piece.Name=="Coat skirt" or piece.Name=="Sleeve" or piece.Name=="Trouser" then piece.Material=Enum.Material.Fabric end
		if ghost then piece.Transparency=.16;piece.CastShadow=false end
	end
	return m
end
function W.lobby()
	local m=workspace:WaitForChild("Midnight Terminal")
	local base=Vector3.new(0,24,420)
	workspace.Terrain:FillBlock(CFrame.new(base+V(0,-12,0)),V(166,16,114),Enum.Material.Rock)
	local clock=W.model(m,"DepartureClock")
	local hub=base+V(0,29,-37)
	W.orb(clock,"Case",V(11,11,1.3),hub,W.brass,Enum.Material.Metal)
	W.orb(clock,"Porcelain",V(10.2,10.2,1.4),hub,W.cream)
	for i=0,11 do
		local a=i*math.pi/6
		W.part(clock,"Hour",V(.22,.7,.12),hub+V(math.sin(a)*4.5,math.cos(a)*4.5,.78),W.ink,false).Rotation=V(0,0,-math.deg(a))
	end
	W.part(clock,"Minute",V(.25,3.6,.15),hub,W.ink,false)
	W.part(clock,"HourHand",V(.39,2.45,.19),hub,W.red,false)
	for _,z in {-45,-34} do W.beam(m,base+V(-65,.62,z),base+V(65,.62,z),.4,W.brass) end
	for x=-50,50,10 do W.orb(m,"Bogie",V(3.1,3.1,1.05),base+V(x,1.7,-34),W.ink,Enum.Material.Metal) end
	W.beam(m,base+V(-62,15,1),base+V(62,15,1),.24,W.brass)
	for i=1,3 do
		local carrier=W.model(m,"CablePost"..i)
		local box=W.box(carrier,base+V(i*12,12.8,1),V(3,1.8,2),W.teal)
		carrier.PrimaryPart=box
		for _,piece in carrier:GetChildren() do if piece:IsA("BasePart") then piece.CanCollide=false end end
		W.beam(carrier,box.Position+V(0,.9,0),box.Position+V(0,2.2,0),.18,W.ink)
	end
	local stands={}
	for i=1,4 do
		stands[i]={caption=m["Platform "..i]:FindFirstChildWhichIsA("TextLabel",true),prompt=m["Boarding desk "..i].Join}
	end
	local lines={"Two signatures open the house. Bring a partner to a numbered desk.","The reader relays the witness statement. The keyholder works the seals.","A wrong seal wakes the keeper. Look closely before you turn it."}
	for i,name in {"Nell • stationmaster","Pip • sorter","Moss • night watch"} do
		local old=m[name]
		local pos=old.Coat.Position-V(0,3.3,0)
		old:Destroy()
		local npc=W.figure(m,name,pos,false)
		local q=W.prompt(npc.PrimaryPart,"Talk","Ask about the house",7)
		q.ObjectText=name
		q.Triggered:Connect(function(p)
			p:SetAttribute("TerminalMessage",lines[i]);p:SetAttribute("MessageAt",workspace:GetServerTimeNow())
		end)
	end
	for _,bench in m:GetChildren() do
		if bench.Name~="Oak bench" then continue end
		local seat=Instance.new("Seat")
		seat.Name="Waiting room seat";seat.Size=V(3,.24,1.7)
		seat.CFrame=bench.CFrame*CFrame.new(0,bench.Size.Y/2+.12,0)
		seat.Anchored=true;seat.Transparency=1;seat.Parent=m
		local prompt=W.prompt(seat,"Rest","Take a seat",6)
		prompt.Triggered:Connect(function(p)
			local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if h and not seat.Occupant then seat:Sit(h) end
		end)
		seat:GetPropertyChangedSignal("Occupant"):Connect(function() prompt.Enabled=seat.Occupant==nil end)
	end
	for i=1,4 do
		local gate=m["Gatehouse "..i];local pos=stands[i].prompt.Parent.Position
		for _,side in {-1,1} do W.part(gate,"Threshold tube",V(.25,7,.25),pos+V(side*7,2,4),W.teal,false,Enum.Material.Neon) end
	end
	local wall=W.part(m,"Waiting room end wall",V(148,15,1),base+V(0,7,49),rgb(94,90,79),true,Enum.Material.Brick)
	for i=-3,3 do
		local pos=wall.Position+V(i*19,1,-.65)
		W.part(m,"Frosted transom",V(13,6,.28),pos,rgb(138,152,149),false,Enum.Material.Glass)
		W.part(m,"Mullion",V(.35,6,.5),pos,W.ink,false)
	end
	return m.Arrival,stands,m["Classic dispatch"].Classic
end
return W
</ProtectedString></Properties></Item><Item class="Script" referent="RBXnewTerminal"><Properties><string name="Name">Terminal</string><ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Market=game:GetService("MarketplaceService")
local policy=game:GetService("PolicyService")
local studio=game:GetService("RunService"):IsStudio()
local W=require(script.Parent.PostalScenery)
local tour=require(script.Parent.ParcelTour)
local records=require(script.Parent.CourierRecords)
local catalog=require(RS.TerminalCatalog)
local spawn,stands,classic=W.lobby()
local event=Instance.new("RemoteEvent")
event.Name,event.Parent="TerminalEvent",RS
local throttle={}
local function message(p,txt)
	p:SetAttribute("TerminalMessage",txt);p:SetAttribute("MessageAt",workspace:GetServerTimeNow())
end
local function move(p,cf)
	local c=p.Character;local r=c and c:FindFirstChild("HumanoidRootPart")
	if r then c:PivotTo(cf);r.AssemblyLinearVelocity=Vector3.zero;r.AssemblyAngularVelocity=Vector3.zero end
end
local lobbySlots={}
local function arrival(p)
	local slot=lobbySlots[p] or 0
	return spawn.CFrame*CFrame.new((slot%8-3.5)*3.4,4,(math.floor(slot/8)-2)*3.4)
end
local function home(p,msg)
	if not p.Parent then return end
	p:SetAttribute("Area","Lobby");p:SetAttribute("Stand",0);p:SetAttribute("TutorialReady",false)
	move(p,arrival(p))
	if msg and msg~="" then message(p,msg) end
end
local function draw(i)
	local s=stands[i]
	s.caption.Text=string.format("TRACK  %02d\n%s",i,s.running and "OUT ON DELIVERY" or (#s.queue.." / 2   •   BOARDING"))
	s.prompt.Enabled=not s.running
	local booth=spawn.Parent["Gatehouse "..i]
	for seat=1,2 do
		booth["Signal"..seat].Color=if s.running then Color3.fromRGB(180,71,58) elseif seat&lt;=#s.queue then Color3.fromRGB(248,187,88) else Color3.fromRGB(109,217,178)
	end
	local stateColor=s.running and W.red or (#s.queue==1 and W.brass or W.teal)
	for _,piece in booth:GetChildren() do
		if piece.Name=="Threshold tube" then piece.Color=stateColor end
	end
	booth:SetAttribute("BoardingState",s.running and "Away" or (#s.queue==1 and "Calling" or "Open"))
	s.prompt.ActionText=#s.queue==1 and "Join or leave crew" or "Punch ticket"
	s.prompt.ObjectText=string.format("Track %02d  •  %s",i,#s.queue==1 and "One courier waiting" or "Two seats")
end
local function unqueue(p)
	for i,s in stands do
		local idx=table.find(s.queue,p)
		if idx then table.remove(s.queue,idx);draw(i) end
	end
	p:SetAttribute("Stand",0)
end
local function depart(i)
	local s=stands[i];if s.running or #s.queue~=2 then return end
	local crew=s.queue;s.queue={};s.running=true;draw(i)
	tour.start(i,crew,home,function() s.running=false;draw(i) end)
end
local function near(p,q)
	local r=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	return r and (r.Position-q.Parent.Position).Magnitude&lt;=q.MaxActivationDistance+1
end
for i,s in stands do
	s.queue={};draw(i)
	s.prompt.Triggered:Connect(function(p)
		if p:GetAttribute("Area")~="Lobby" or not p:GetAttribute("RecordReady") or s.running or not near(p,s.prompt) then return end
		if table.find(s.queue,p) then unqueue(p);return end
		unqueue(p);message(p,"Ticket punched. A second courier starts the route, then both of you can open the house.");table.insert(s.queue,p);p:SetAttribute("Stand",i);draw(i)
		if #s.queue==2 then depart(i) end
	end)
end
classic.Triggered:Connect(function(p)
	if p:GetAttribute("Area")~="Lobby" or not p:GetAttribute("RecordReady") or not near(p,classic) then return end
	local slots={}
	for _,other in Players:GetPlayers() do if other:GetAttribute("Area")=="Classic" then slots[other:GetAttribute("ClassicLane") or 1]=true end end
	for i=1,4 do if not slots[i] then
		unqueue(p);p:SetAttribute("ClassicLane",i);p:SetAttribute("Area","Classic")
		move(p,workspace.NightPost.DispatchSpawn.CFrame*CFrame.new(i*2-5,4,0));return
	end end
	message(p,"Classic crew is full.")
end)
local function register(p)
	local used={}
	for _,slot in lobbySlots do used[slot]=true end
	local slot=0
	while used[slot] do slot+=1 end
	lobbySlots[p]=slot
	p.RespawnLocation=spawn
	p:SetAttribute("Area","Lobby");p:SetAttribute("Stand",0)
	local function appeared(c)
		if not c:WaitForChild("HumanoidRootPart",12) or c~=p.Character then return end
		local area=p:GetAttribute("Area")
		if area=="Tour" then tour.respawn(p)
		elseif area~="Classic" then move(p,arrival(p)) end
	end
	p.CharacterAdded:Connect(appeared)
	if p.Character then task.spawn(appeared,p.Character) end
	task.spawn(function()
		local ok,info=pcall(function() return policy:GetPolicyInfoForPlayerAsync(p) end)
		if p.Parent then p:SetAttribute("PaidWheelAllowed",ok and info.ArePaidRandomItemsRestricted==false) end
	end)
end
Players.PlayerAdded:Connect(register)
for _,p in Players:GetPlayers() do register(p) end
Players.PlayerRemoving:Connect(function(p) unqueue(p);tour.leave(p);throttle[p]=nil;lobbySlots[p]=nil end)
local function grant(key,t,data)
	local product=catalog.products[key]
	if product.coins then data.Coins+=product.coins
	elseif key=="Spin" then t.SpinTickets=(t.SpinTickets or 0)+1
	elseif key=="Horn" then t.HornTickets=(t.HornTickets or 0)+1 end
end
Market.ProcessReceipt=function(receipt)
	local p=Players:GetPlayerByUserId(receipt.PlayerId)
	if not p or not p:GetAttribute("RecordReady") then return Enum.ProductPurchaseDecision.NotProcessedYet end
	for key,v in catalog.products do
		if v.id&gt;0 and v.id==receipt.ProductId then
			local ok=records.terminal(p,function(t,data)
				if not t.receipts[receipt.PurchaseId] then
					grant(key,t,data);t.receipts[receipt.PurchaseId]=true
				end
			end)
			if ok then return Enum.ProductPurchaseDecision.PurchaseGranted end
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end
event.OnServerEvent:Connect(function(p,action,key)
	if time()&lt;(throttle[p] or 0) or not p:GetAttribute("RecordReady") then return end
	throttle[p]=time()+.25
	local area=p:GetAttribute("Area")
	if action=="Return" then
		unqueue(p);tour.leave(p);home(p);return
	elseif action=="Ready" and area=="Tutorial" then tour.ready(p);return end
	if area~="Lobby" then return end
	local stand=p:GetAttribute("Stand") or 0
	if action=="Unqueue" then unqueue(p);return end
	local day=math.floor(os.time()/86400)
	if action=="Buy" then
		local item=catalog.products[key]
		if not item then return end
		if key=="Spin" and not studio and not p:GetAttribute("PaidWheelAllowed") then message(p,"Paid wheel tickets are unavailable.");return end
		if studio then
			local ok=records.terminal(p,function(t,data) grant(key,t,data) end)
			message(p,ok and ("Studio demo granted: "..item.name) or "Wallet busy. Try again.")
		elseif item.id&gt;0 then
			local ok=pcall(function() Market:PromptProductPurchase(p,item.id) end)
			if not ok then message(p,"Purchase prompt unavailable.") end
		else message(p,"This product has not been connected yet.") end
		return
	end
	if action=="Claim" then
		if p:GetAttribute("ClaimDate")==day then message(p,"Already collected. Return after midnight UTC.");return end
		local ok,amount=records.terminal(p,function(t,data)
			if (t.ClaimDate or 0)&gt;=day then return 0 end
			local step=(t.ClaimStep or 0)%7+1
			t.ClaimDate,t.ClaimStep=day,step
			data.Coins+=catalog.daily[step];return catalog.daily[step]
		end)
		message(p,ok and ("Daily collection: +"..amount.." coins") or "Wallet busy. Try again.")
	elseif action=="Spin" then
		local paid=p:GetAttribute("SpinDate")==day
		if paid and ((p:GetAttribute("SpinTickets") or 0)&lt;1 or (not studio and not p:GetAttribute("PaidWheelAllowed"))) then message(p,"Your free spin returns at midnight UTC.");return end
		local sector=Random.new():NextInteger(1,#catalog.wheel)
		local ok,used=records.terminal(p,function(t,data)
			if (t.SpinDate or 0)&lt;day then t.SpinDate=day
			elseif (t.SpinTickets or 0)&gt;0 and (studio or p:GetAttribute("PaidWheelAllowed")) then t.SpinTickets-=1
			else return false end
			data.Coins+=catalog.wheel[sector];return true
		end)
		if ok and used then event:FireClient(p,"Wheel",sector) else message(p,"Spin unavailable. Try again.") end
	elseif action=="Scare" and (p:GetAttribute("HornTickets") or 0)&gt;0 then
		local ok,used=records.terminal(p,function(t)
			if (t.HornTickets or 0)&lt;1 then return false end
			t.HornTickets-=1;return true
		end)
		if ok and used then
			for _,other in Players:GetPlayers() do if other:GetAttribute("Area")=="Lobby" then event:FireClient(other,"Scare") end end
		else message(p,"Telegram pending. Try again.") end
	end
end)
