		</Properties>
		<Item class="Script" referent="RBX174">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ServerScriptService > Shift (Script)
local Players = game:GetService("Players")
local district = workspace:WaitForChild("NightPost")
local spawnPad = district.DispatchSpawn
local pickup = district.DispatchCounter.Pickup
local deliver = district.RedMailbox.Deliver

local SHIFT_SECONDS = 60
local PARCELS_PER_PICKUP = 2
local COINS_PER_PARCEL = 10
local RESTART_SECONDS = 4
local states = {}
local phase = "Ready"
local deadline = 0
local restartAt = 0

local function setPhase(nextPhase, endsAt)
	phase = nextPhase
	deadline = endsAt
	district:SetAttribute("EndsAt", deadline)
	district:SetAttribute("Phase", phase)
end

local function renderBag(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local old = character:FindFirstChild("MailSatchel")
	if old then old:Destroy() end
	local state = states[player]
	if not state or state.carried == 0 then return end
	local bag = Instance.new("Model")
	bag.Name = "MailSatchel"
	for i = 1, state.carried do
		local box = Instance.new("Part")
		box.Name = "Parcel" .. i
		box.Size = Vector3.new(1.8, 0.85, 1.15)
		box.Color = i == 1 and Color3.fromRGB(209, 151, 99) or Color3.fromRGB(241, 190, 118)
		box.Material = Enum.Material.SmoothPlastic
		box.CanCollide = false
		box.CanTouch = false
		box.CanQuery = false
		box.Massless = true
		box.CFrame = root.CFrame * CFrame.new(0, -0.5 + (i - 1) * 0.88, 1.12)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = box
		weld.Parent = box
		box.Parent = bag
	end
	bag.Parent = character
end

local function setLoad(player, status, amount)
	local state = states[player]
	state.status = status
	state.carried = amount
	player:SetAttribute("Carried", amount)
	player:SetAttribute("DeliveryStatus", status)
	renderBag(player)
end

local function backToDispatch(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local lane = states[player].lane
	character:PivotTo(spawnPad.CFrame * CFrame.new((lane - 2.5) * 3, 3.5, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

local function everyoneDelivered()
	if not next(states) then return false end
	for _, state in pairs(states) do
		if state.status ~= "Paid" then return false end
	end
	return true
end

local function endShift()
	restartAt = workspace:GetServerTimeNow() + RESTART_SECONDS
	setPhase("Break", 0)
	for player, state in pairs(states) do
		if state.status ~= "Paid" then
			setLoad(player, "Expired", 0)
		end
	end
end

local function resetShift()
	for player in pairs(states) do
		setLoad(player, "Waiting", 0)
		backToDispatch(player)
	end
	setPhase("Ready", 0)
end

local function inRange(player, prompt)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return root and humanoid and humanoid.Health > 0
		and (root.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance + 1
end

pickup.Triggered:Connect(function(player)
	local state = states[player]
	if not state or state.status ~= "Waiting" or phase == "Break" then return end
	if not inRange(player, pickup) then return end
	local now = workspace:GetServerTimeNow()
	if phase == "Ready" then
		setPhase("Running", now + SHIFT_SECONDS)
	elseif now >= deadline then
		return
	end
	setLoad(player, "Carrying", PARCELS_PER_PICKUP)
end)

deliver.Triggered:Connect(function(player)
	local state = states[player]
	if not state or phase ~= "Running" or state.status ~= "Carrying" then return end
	if workspace:GetServerTimeNow() >= deadline or not inRange(player, deliver) then return end
	local pay = state.carried * COINS_PER_PARCEL
	state.coins += pay
	player:SetAttribute("Coins", state.coins)
	player:SetAttribute("LastPay", pay)
	setLoad(player, "Paid", 0)
	if everyoneDelivered() then endShift() end
end)

local function register(player)
	if states[player] then return end
	local used = {}
	for _, state in pairs(states) do used[state.lane] = true end
	local lane = 1
	while used[lane] do lane += 1 end
	states[player] = {status = "Waiting", carried = 0, coins = 0, lane = lane}
	player.RespawnLocation = spawnPad
	player:SetAttribute("Coins", 0)
	player:SetAttribute("LastPay", 0)
	setLoad(player, "Waiting", 0)
	local function spawned(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and player.Character == character and states[player] then
			backToDispatch(player)
			renderBag(player)
		end
	end
	player.CharacterAdded:Connect(spawned)
	if player.Character then task.spawn(spawned, player.Character) end
end

district:SetAttribute("ShiftSeconds", SHIFT_SECONDS)
setPhase("Ready", 0)
Players.PlayerAdded:Connect(register)
Players.PlayerRemoving:Connect(function(player)
	states[player] = nil
	if not next(states) then
		setPhase("Ready", 0)
	elseif phase == "Running" and everyoneDelivered() then
		endShift()
	end
end)
for _, player in Players:GetPlayers() do register(player) end

while true do
	local now = workspace:GetServerTimeNow()
	if phase == "Running" and now >= deadline then
		endShift()
	elseif phase == "Break" and now >= restartAt then
		resetShift()
	end
	for player in pairs(states) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root.Position.Y < spawnPad.Position.Y - 13 then
			backToDispatch(player)
		end
	end
	task.wait(0.15)
end
]]></ProtectedString>
