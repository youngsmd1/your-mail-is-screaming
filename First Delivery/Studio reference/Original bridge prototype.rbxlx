			<Item class="LocalScript" referent="RBX177">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- StarterPlayer > StarterPlayerScripts > ShiftHUD (LocalScript)
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local district = workspace:WaitForChild("NightPost")
local pickup = district:WaitForChild("DispatchCounter"):WaitForChild("Pickup")
local deliver = district:WaitForChild("RedMailbox"):WaitForChild("Deliver")

local gui = Instance.new("ScreenGui")
gui.Name = "ShiftHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Name = "DispatchSlip"
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 7)
panel.Size = UDim2.new(0.94, 0, 0, 68)
panel.BackgroundColor3 = Color3.fromRGB(25, 34, 46)
panel.BackgroundTransparency = 0.06
panel.BorderSizePixel = 0
panel.Parent = gui
local limit = Instance.new("UISizeConstraint")
limit.MaxSize = Vector2.new(530, 68)
limit.Parent = panel

local function label(name, size, position, color, font, textSize)
	local text = Instance.new("TextLabel")
	text.Name = name
	text.Size = size
	text.Position = position
	text.BackgroundTransparency = 1
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextColor3 = color
	text.Font = font
	text.TextSize = textSize
	text.TextWrapped = true
	text.Text = ""
	text.Parent = panel
	return text
end

local gold = Color3.fromRGB(255, 211, 107)
local paper = Color3.fromRGB(250, 246, 230)
local clock = label("Time", UDim2.new(0.5, -12, 0, 24), UDim2.fromOffset(12, 2), gold, Enum.Font.Code, 16)
local load = label("Parcels", UDim2.new(0.5, -12, 0, 24), UDim2.new(0.5, 0, 0, 2), gold, Enum.Font.Code, 16)
load.TextXAlignment = Enum.TextXAlignment.Right
local objective = label("Objective", UDim2.new(1, -24, 0, 39), UDim2.fromOffset(12, 25), paper, Enum.Font.GothamMedium, 15)

local function faceMailbox(character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root and player.Character == character and workspace.CurrentCamera then
		local target = district.RedMailbox.Position
		local eye = root.Position + Vector3.new(0, 5, 10)
		workspace.CurrentCamera.CFrame = CFrame.lookAt(eye, target)
	end
end
player.CharacterAdded:Connect(faceMailbox)
if player.Character then task.spawn(faceMailbox, player.Character) end

while gui.Parent do
	local phase = district:GetAttribute("Phase")
	local status = player:GetAttribute("DeliveryStatus")
	local remaining = district:GetAttribute("ShiftSeconds") or 60
	if phase == "Running" then
		remaining = math.max(0, math.ceil((district:GetAttribute("EndsAt") or 0) - workspace:GetServerTimeNow()))
	elseif phase == "Break" then
		remaining = 0
	end
	clock.Text = string.format("SHIFT  %d:%02d", math.floor(remaining / 60), remaining % 60)
	load.Text = string.format("PARCELS  %d", player:GetAttribute("Carried") or 0)
	pickup.Enabled = status == "Waiting" and (phase == "Ready" or phase == "Running")
	deliver.Enabled = status == "Carrying" and phase == "Running"
	if status == "Paid" then
		local tail = phase == "Break" and "Back to dispatch soon." or "Waiting for your crew."
		objective.Text = string.format("+%d coins · %d total. %s",
			player:GetAttribute("LastPay") or 0, player:GetAttribute("Coins") or 0, tail)
	elseif phase == "Break" then
		objective.Text = "Shift closed. Back to dispatch soon."
	elseif status == "Carrying" then
		objective.Text = "Take the bridge on your left to the red mailbox."
	else
		objective.Text = "Pick up two parcels at the dispatch counter."
	end
	task.wait(0.1)
end
]]></ProtectedString>
